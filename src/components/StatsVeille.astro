---
/** Les chiffres de l'outil de veille, uniquement depuis /api/vitrine/stats (agrégats). Rien d'autre, rien de calculé ailleurs. */
import { getEntry } from 'astro:content';

interface Props {
  /** Numéro du repère « § n » de la section. */
  numero?: number;
}
const { numero = 2 } = Astro.props;

interface Mois { mois: string; collectes?: number | null; retenus?: number | null }
const stats = (await getEntry('vitrine', 'stats'))?.data as
  | { items_par_mois?: Mois[]; posts_publies?: number; fiches?: number; focus?: number }
  | undefined;
const mois = (stats?.items_par_mois ?? []).filter((m) => typeof m?.mois === 'string').slice(-12).reverse();
const nomMois = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const libelle = (m: string) => {
  const d = new Date(`${m}-01T00:00:00Z`);
  return Number.isNaN(d.getTime()) ? m : nomMois.format(d);
};
const n = (v: number | null | undefined) => (typeof v === 'number' ? v.toLocaleString('fr-FR') : '');
const pluriel = (v: number | undefined, un: string, plusieurs: string) => (v != null && v >= 2 ? plusieurs : un);
---

{stats && (
  <section class="section">
    <div class="repere"><span class="mono-label">§ {numero}<br />En chiffres</span></div>
    <div class="contenu bloc large">
      <p class="compteurs">
        <span><strong>{n(stats.posts_publies)}</strong> {pluriel(stats.posts_publies, 'post partagé', 'posts partagés')}</span>
        <span><strong>{n(stats.fiches)}</strong> {pluriel(stats.fiches, 'fiche hebdo', 'fiches hebdo')}</span>
        <span><strong>{n(stats.focus)}</strong> {pluriel(stats.focus, 'dossier focus', 'dossiers focus')}</span>
      </p>
      {mois.length > 0 && (
        <div class="defilant">
          <table>
            <caption class="mono-meta">Articles par mois, douze derniers mois</caption>
            <thead>
              <tr><th>Mois</th><th>Collectés</th><th>Retenus</th></tr>
            </thead>
            <tbody>
              {mois.map((m) => (
                <tr><td>{libelle(m.mois)}</td><td>{n(m.collectes)}</td><td>{n(m.retenus)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>
)}
