---
/** Un outil : son texte Markdown, le lien vers l'outil, et pour la veille les chiffres de la vitrine. */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatsVeille from '../../components/StatsVeille.astro';

export async function getStaticPaths() {
  return (await getCollection('outils', (o) => !o.data.brouillon)).map((o) => ({ params: { id: o.id }, props: { outil: o } }));
}

const { outil } = Astro.props;
const { Content } = await render(outil);
---

<Base titre={outil.data.titre} description={outil.data.resume} image={`/og/outil-${outil.id}.png`}>
  <section class="hero page">
    <div class="repere">
      <span class="mono-label"><a href="/outils/" style="color:inherit;text-decoration:none">← Outils</a></span>
      <p class="meta"><span class="type">outil</span>{outil.data.lien && <span>accès privé</span>}</p>
    </div>
    <div class="contenu">
      <h1 class="title-1">{outil.data.titre}</h1>
      <p class="lead">{outil.data.resume}</p>
      {outil.data.lien && <p><a class="lien-action" href={outil.data.lien} rel="noopener">Ouvrir l'outil ↗</a></p>}
    </div>
  </section>

  <section class="section">
    <div class="repere"><span class="mono-label">§ 1<br />L'outil</span></div>
    <div class="contenu prose">
      <Content />
    </div>
  </section>

  {outil.id === 'veille' && <StatsVeille numero={2} />}
</Base>
