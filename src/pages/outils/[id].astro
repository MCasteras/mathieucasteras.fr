---
/** Un outil : son texte Markdown, le lien vers l'outil, et pour la veille les chiffres de la vitrine. */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatsVeille from '../../components/StatsVeille.astro';

export async function getStaticPaths() {
  return (await getCollection('outils', (o) => !o.data.brouillon)).map((o) => ({ params: { id: o.id }, props: { outil: o } }));
}

const { outil } = Astro.props;
const { Content } = await render(outil);
---

<Base titre={outil.data.titre} description={outil.data.resume}>
  <p><a href="/outils/">← Outils</a></p>
  <h1>{outil.data.titre}</h1>
  <p class="chapeau">{outil.data.resume}</p>
  {outil.data.lien && <p><a href={outil.data.lien} rel="noopener">Ouvrir l'outil →</a> <span class="meta" style="display:inline">(accès privé)</span></p>}
  <div class="prose">
    <Content />
  </div>
  {outil.id === 'veille' && <StatsVeille />}
</Base>
