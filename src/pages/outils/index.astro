---
/** Outils : la liste, la veille en premier. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const outils = (await getCollection('outils', (o) => !o.data.brouillon)).sort((a, b) => a.data.ordre - b.data.ordre);
---

<Base titre="Outils" description="Les outils que je construis pour mon travail de Forward Deployed Engineer." image="/og/outils.png">
  <section class="hero page">
    <div class="repere"><span class="mono-label">Outils<br /><span class="compte">{outils.length}</span></span></div>
    <div class="contenu">
      <h1 class="title-1">Outils</h1>
      <p class="lead">Je construis les outils dont j'ai besoin pour mon travail : c'est aussi ma façon d'éprouver en conditions réelles ce que je recommande.</p>
    </div>
  </section>

  <section class="section">
    <div class="repere"><span class="mono-label">§ 1<br />Les outils</span></div>
    <div class="contenu">
      <ul class="liste-veille">
        {outils.map((o, i) => (
          <li>
            <a class="ligne" href={`/outils/${o.id}/`}>
              <span class="mono-meta">{String(i + 1).padStart(2, '0')}</span>
              <span class="mono-meta type">outil</span>
              <span class="ligne-titre">{o.data.titre}</span>
              <span class="ligne-extrait">{o.data.resume}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
