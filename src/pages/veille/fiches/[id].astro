---
/** Une fiche hebdo : en une phrase, jalons, prêt pour la production, expérimental, à tester, questions, sources numérotées. */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Refs from '../../../components/Refs.astro';
import Sources from '../../../components/Sources.astro';
import Themes from '../../../components/Themes.astro';
import { dateFr } from '../../../lib/format';

export async function getStaticPaths() {
  return (await getCollection('fiches')).map((f) => ({ params: { id: f.id }, props: { fiche: f } }));
}

const { fiche } = Astro.props;
const d = fiche.data;
const titre = d.titre || fiche.id;

/** Les blocs de la fiche, dans l'ordre, seulement ceux qui ont du contenu : chacun devient une section à repère. */
const blocs: Array<{ nom: string; contenu: 'jalons' | 'pret_prod' | 'experimental' | 'a_tester' | 'questions' }> = [
  { nom: 'Jalons', contenu: 'jalons' },
  { nom: 'Prêt pour la production', contenu: 'pret_prod' },
  { nom: 'Expérimental', contenu: 'experimental' },
  { nom: 'À tester', contenu: 'a_tester' },
  { nom: 'Questions ouvertes', contenu: 'questions' },
];
const presents = blocs.filter((b) => (d[b.contenu] ?? []).length > 0);
---

<Base titre={titre} description={d.en_une_phrase ?? undefined} image={`/og/fiche-${fiche.id}.png`}>
  <section class="hero page">
    <div class="repere">
      <span class="mono-label"><a href="/veille/#fiches" style="color:inherit;text-decoration:none">← Fiches hebdo</a></span>
      <p class="meta"><span class="type">fiche</span>{d.semaine != null && <span>semaine {d.semaine}</span>}</p>
    </div>
    <div class="contenu">
      <h1 class="title-1">{titre}</h1>
      <p class="meta">
        {d.periode && <span>{d.periode}</span>}
        {d.valide_le && <span>validée le {dateFr(d.valide_le)}</span>}
        {d.modele?.applique && <span>rédigée avec {d.modele.applique}</span>}
      </p>
      <div class="etiquettes"><Themes themes={d.themes} /></div>
      {d.en_une_phrase && <p class="lead" style="margin-top:var(--space-3)">{d.en_une_phrase}</p>}
    </div>
  </section>

  {presents.map((b, i) => (
    <section class="section">
      <div class="repere"><span class="mono-label">§ {i + 1}<br />{b.nom}</span></div>
      <div class="contenu bloc">
        {b.contenu === 'jalons' && (
          <ul>{d.jalons!.map((j) => <li>{j.date && <span class="mono-meta">{j.date.slice(0, 10)} — </span>}{j.texte}<Refs refs={j.refs} /></li>)}</ul>
        )}
        {b.contenu === 'pret_prod' && <ul>{d.pret_prod!.map((t) => <li>{t}</li>)}</ul>}
        {b.contenu === 'experimental' && <ul>{d.experimental!.map((t) => <li>{t}</li>)}</ul>}
        {b.contenu === 'a_tester' && <ul>{d.a_tester!.map((a) => <li>{a.texte}<Refs refs={a.refs} /></li>)}</ul>}
        {b.contenu === 'questions' && <ul>{d.questions!.map((q) => <li>{q.texte}</li>)}</ul>}
      </div>
    </section>
  ))}

  <Sources sources={d.sources} numero={presents.length + 1} />
</Base>
