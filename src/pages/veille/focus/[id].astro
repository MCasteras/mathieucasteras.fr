---
/** Un dossier focus : cadre, verdict, en bref, fonctionnement, benchmarks, alternatives, terrain, limites, questions, sources. */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Refs from '../../../components/Refs.astro';
import Sources from '../../../components/Sources.astro';
import Themes from '../../../components/Themes.astro';
import { dateFr } from '../../../lib/format';

export async function getStaticPaths() {
  return (await getCollection('focus')).map((f) => ({ params: { id: f.id }, props: { focus: f } }));
}

const { focus } = Astro.props;
const d = focus.data;
const dossier = d.dossier ?? {};
const cadre = d.cadre ?? {};
const titre = dossier.titre || cadre.titre || focus.id;
const etapes = dossier.fonctionnement?.etapes ?? [];

/** Les sections présentes, numérotées dans l'ordre d'affichage. */
const sections: string[] = [];
const num = (nom: string) => {
  sections.push(nom);
  return sections.length;
};
const aEnBref = (dossier.en_bref ?? []).length > 0;
const aPerimetre = Boolean(cadre.perimetre?.inclus?.length || cadre.perimetre?.exclus?.length);
const aFonctionnement = etapes.length > 0 || Boolean(dossier.fonctionnement?.texte);
const aBenchmarks = (dossier.benchmarks ?? []).length > 0;
const aAlternatives = (dossier.alternatives ?? []).length > 0;
const aTerrain = (dossier.terrain ?? []).length > 0;
const aLimites = (dossier.limites ?? []).length > 0;
const aQuestions = (dossier.questions_ouvertes ?? []).length > 0;
---

<Base titre={titre} description={dossier.verdict ?? undefined} image={`/og/focus-${focus.id}.png`}>
  <section class="hero page">
    <div class="repere">
      <span class="mono-label"><a href="/veille/#focus" style="color:inherit;text-decoration:none">← Dossiers focus</a></span>
      <p class="meta"><span class="type">focus</span>{dossier.stats?.lues != null && <span>{dossier.stats.lues} lues{dossier.stats.retenues != null && `, ${dossier.stats.retenues} retenues`}</span>}</p>
    </div>
    <div class="contenu">
      <h1 class="title-1">{titre}</h1>
      <p class="meta">
        {d.pret_le && <span>prêt le {dateFr(d.pret_le)}</span>}
        {d.maj_le && <span>mis à jour le {dateFr(d.maj_le)}</span>}
        {d.modele?.applique && <span>rédigé avec {d.modele.applique}</span>}
      </p>
      <div class="etiquettes"><Themes themes={cadre.themes} /></div>
      {dossier.verdict && <p class="lead" style="margin-top:var(--space-3)">{dossier.verdict}</p>}
    </div>
  </section>

  {aEnBref && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('En bref')}<br />En bref</span></div>
      <div class="contenu bloc"><ul>{dossier.en_bref!.map((t) => <li>{t}</li>)}</ul></div></section>
  )}

  {aPerimetre && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Périmètre')}<br />Périmètre</span></div>
      <div class="contenu bloc">
        <dl class="fiche-dl">
          {cadre.perimetre?.inclus?.length ? <><dt>Inclus</dt>{cadre.perimetre.inclus.map((t) => <dd>{t}</dd>)}</> : null}
          {cadre.perimetre?.exclus?.length ? <><dt>Exclus</dt>{cadre.perimetre.exclus.map((t) => <dd>{t}</dd>)}</> : null}
        </dl>
      </div></section>
  )}

  {aFonctionnement && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Comment ça marche')}<br />Comment ça marche</span></div>
      <div class="contenu bloc">
        {etapes.length > 0 && (
          <ol>
            {etapes.map((e) => (
              <li>
                {e.titre && <strong>{e.titre}{e.nouveau && <span class="etiquette" style="margin-left:var(--space-2)">nouveau</span>} — </strong>}
                {e.texte}
              </li>
            ))}
          </ol>
        )}
        {dossier.fonctionnement?.texte && <p>{dossier.fonctionnement.texte}</p>}
      </div></section>
  )}

  {aBenchmarks && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Benchmarks')}<br />Benchmarks</span></div>
      <div class="contenu defilant">
        <table>
          <thead><tr><th>Nom</th><th>Annoncé</th><th>Indépendant</th><th>Par</th><th>Fiabilité</th><th>Réf.</th></tr></thead>
          <tbody>
            {dossier.benchmarks!.map((b) => (
              <tr><td>{b.nom}</td><td>{b.annonce}</td><td>{b.independant}</td><td>{b.par}</td><td>{b.fiabilite}</td><td><Refs refs={b.refs} /></td></tr>
            ))}
          </tbody>
        </table>
      </div></section>
  )}

  {aAlternatives && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Alternatives')}<br />Alternatives</span></div>
      <div class="contenu defilant">
        <table>
          <thead><tr><th>Nom</th><th>Licence</th><th>Maturité</th><th>Pour</th><th>Contre</th><th>Réf.</th></tr></thead>
          <tbody>
            {dossier.alternatives!.map((a) => (
              <tr><td>{a.nom}</td><td>{a.licence}</td><td>{a.maturite}</td><td>{a.pour}</td><td>{a.contre}</td><td><Refs refs={a.refs} /></td></tr>
            ))}
          </tbody>
        </table>
      </div></section>
  )}

  {aTerrain && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Pour le terrain')}<br />Pour le terrain</span></div>
      <div class="contenu bloc"><ul>{dossier.terrain!.map((t) => <li>{t.texte}<Refs refs={t.refs} /></li>)}</ul></div></section>
  )}

  {aLimites && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Limites et inconnues')}<br />Limites et inconnues</span></div>
      <div class="contenu bloc"><ul>{dossier.limites!.map((t) => <li>{t.texte}<Refs refs={t.refs} /></li>)}</ul></div></section>
  )}

  {aQuestions && (
    <section class="section"><div class="repere"><span class="mono-label">§ {num('Questions ouvertes')}<br />Questions ouvertes</span></div>
      <div class="contenu bloc"><ul>{dossier.questions_ouvertes!.map((q) => <li>{q}</li>)}</ul></div></section>
  )}

  <Sources sources={dossier.sources} numero={sections.length + 1} />
</Base>
