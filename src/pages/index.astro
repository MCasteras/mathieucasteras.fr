---
/** Accueil, structure M2 : la promesse, § 1 Méthode, § 2 Veille, § 3 Outils, § 4 Contact. */
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import LigneVeille from '../components/LigneVeille.astro';
import { extrait } from '../lib/format';

const etat = await getEntry('vitrine', 'index');
const comptes = (etat?.data.comptes ?? {}) as Record<string, number>;

/** Les derniers documents publiés, toutes natures confondues, par date décroissante. */
const lignes = [
  ...(await getCollection('posts')).map((p) => ({ href: `/veille/posts/${p.id}/`, date: p.data.publie_le, type: 'post', titre: p.data.titres?.[0] || extrait(p.data.texte, 80) || p.id })),
  ...(await getCollection('fiches')).map((f) => ({ href: `/veille/fiches/${f.id}/`, date: f.data.valide_le, type: 'fiche', titre: f.data.titre || f.id })),
  ...(await getCollection('focus')).map((f) => ({ href: `/veille/focus/${f.id}/`, date: f.data.pret_le, type: 'focus', titre: f.data.dossier?.titre || f.data.cadre?.titre || f.id })),
]
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 4);
---

<Base titre="Mathieu Casteras" description="Mathieu Casteras, Forward Deployed Engineer : l'IA générative en entreprise, du prototype au terrain.">
  <section class="hero">
    <div class="repere">
      <span class="mono-label">Forward Deployed<br />Engineer<br /><span class="compte">—</span><br />IA générative<br />en entreprise</span>
    </div>
    <div class="contenu">
      <h1 class="display">Vos équipes ont vu des démonstrations d'IA. Je les aide à passer à quelque chose qui tient<span class="point-accent">.</span></h1>
      <p class="lead">Des données, des agents, une évaluation, des coûts tenus, une adoption réelle. [À COMPLÉTER : une phrase sur ce que tu fais aujourd'hui, pour qui, et depuis quand.]</p>
      <div class="boutons">
        <a class="bouton" href="#contact">Parlons de votre cas</a>
        <a class="bouton secondaire" href="#methode">Comment je travaille</a>
      </div>
    </div>
  </section>

  <section class="section" id="methode">
    <div class="repere"><span class="mono-label">§ 1<br />Méthode</span></div>
    <div class="contenu">
      <div class="cartes-methode">
        <article class="carte-methode">
          <span class="mono-label">01 / comprendre</span>
          <h2 class="title-2">Le métier avant le modèle</h2>
          <p>[À COMPLÉTER : trois lignes. Comment tu démarres, avec qui, ce que tu cherches à comprendre d'abord.]</p>
        </article>
        <article class="carte-methode">
          <span class="mono-label">02 / construire</span>
          <h2 class="title-2">Dans vos équipes, pas à côté</h2>
          <p>[À COMPLÉTER : trois lignes. Le prototype, puis ce qui tient en production, avec les gens qui l'utiliseront.]</p>
        </article>
        <article class="carte-methode">
          <span class="mono-label">03 / mesurer</span>
          <h2 class="title-2">Évaluation, coûts, adoption</h2>
          <p>[À COMPLÉTER : trois lignes. Ce que tu mesures, ce que tu rapportes à la direction, quand tu dis non.]</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="veille">
    <div class="repere">
      <span class="mono-label">§ 2<br />Veille<br /><span class="compte">{comptes.posts ?? 0} · {comptes.fiches ?? 0} · {comptes.focus ?? 0}</span></span>
    </div>
    <div class="contenu">
      <p class="body prose-measure" style="color:var(--ink-2);margin-bottom:var(--space-5)">
        Ce que je lis sur l'IA générative en entreprise, et ce que j'en pense. Une fiche par semaine, des dossiers quand un sujet le mérite,
        tenus par des agents que j'ai construits et relus à la main.
      </p>
      {lignes.length === 0 ? <p class="body" style="color:var(--ink-2)">Rien de publié pour le moment.</p> : (
        <ul class="liste-veille">
          {lignes.map((l) => <LigneVeille {...l} />)}
        </ul>
      )}
      <a class="lien-action mono" href="/veille/">→ toute la veille</a>
    </div>
  </section>

  <section class="section" id="outils">
    <div class="repere"><span class="mono-label">§ 3<br />Outils</span></div>
    <div class="contenu bloc">
      <h2 class="title-2">Veille FDE</h2>
      <p class="body" style="color:var(--ink-2)">Un outil de veille tenu par des agents : couche LLM agnostique, SQLite, worker, vitrine publique en lecture seule. C'est lui qui alimente la section précédente.</p>
      <a class="lien-action" href="/outils/veille/">Comment il est construit →</a>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="repere"><span class="mono-label">§ 4<br />Contact</span></div>
    <div class="contenu bloc">
      <h2 class="title-1">Un sujet à défricher, une équipe à embarquer&nbsp;?</h2>
      <p class="body" style="color:var(--ink-2)">[À COMPLÉTER : pour quoi on peut te solliciter, en une phrase. Ville, disponibilité.]</p>
      <div class="boutons">
        <a class="bouton" href="mailto:[À COMPLÉTER]">Écrire à Mathieu</a>
        <a class="lien-action" href="https://www.linkedin.com/in/[À COMPLÉTER]" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</Base>
