---
/** Sources : ce que la veille lit, groupé par type d'accès, depuis /api/vitrine/sources. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Themes from '../../components/Themes.astro';

const sources = await getCollection('sources');
const groupes = new Map<string, typeof sources>();
for (const s of sources) {
  const type = (s.data.type ?? 'autre').trim() || 'autre';
  groupes.set(type, [...(groupes.get(type) ?? []), s]);
}
const ordre = [...groupes.keys()].sort((a, b) => (groupes.get(b)!.length - groupes.get(a)!.length) || a.localeCompare(b, 'fr'));
const majuscule = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---

<Base titre="Sources" description="Les sources que ma veille lit : blogs d'éditeurs et de praticiens, arXiv, dépôts GitHub.">
  <h1>Sources</h1>
  <p class="chapeau">
    Ce que l'outil de veille lit, tel qu'il est configuré aujourd'hui : {sources.length} sources. Chaque entrée renvoie à l'original.
  </p>
  {sources.length === 0 && <p>Aucune source exposée pour le moment.</p>}
  {ordre.map((type) => (
    <section>
      <h2>{majuscule(type)}</h2>
      <ul class="liste">
        {groupes.get(type)!.map((s) => (
          <li>
            <h3>{s.data.url ? <a href={s.data.url} rel="noopener">{s.data.nom || s.data.url}</a> : <span>{s.data.nom || 'Sans nom'}</span>}</h3>
            <p><Themes themes={s.data.themes} /></p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
