---
/** Gabarit de toutes les pages, selon le système de design : nav numérotée en mono, bouton de contact, bascule de thème, pied mono. */
import { getCollection, getEntry } from 'astro:content';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/charte.css';

interface Props {
  titre: string;
  description?: string;
  /** Image Open Graph : `/og/<clé>.png`, voir src/pages/og. Défaut : la carte du site. */
  image?: string;
}

const { titre, description, image = '/og/defaut.png' } = Astro.props;
const SITE = 'Mathieu Casteras';
const titreComplet = titre === SITE ? SITE : `${titre} · ${SITE}`;
const chemin = Astro.url.pathname;
const etat = await getEntry('vitrine', 'index');
const exemple = etat?.data.origine === 'fixtures';

const aDesNotes = (await getCollection('notes', (n) => !n.data.brouillon)).length > 0;

// Notes n'apparaît qu'une fois la première note publiée ; la numérotation suit.
const entrees: Array<[string, string, string]> = [
  ['/#methode', 'Méthode', '/'],
  ['/veille/', 'Veille', '/veille/'],
  ['/outils/', 'Outils', '/outils/'],
  ['/sources/', 'Sources', '/sources/'],
  ...(aDesNotes ? ([['/notes/', 'Notes', '/notes/']] as Array<[string, string, string]>) : []),
];
const nav = entrees.map(([href, nom, prefixe], i) => [href, `${String(i + 1).padStart(2, '0')} ${nom}`, prefixe] as const);

function courant(prefixe: string): 'page' | undefined {
  if (prefixe === '/') return chemin === '/' ? 'page' : undefined;
  return chemin.startsWith(prefixe) ? 'page' : undefined;
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(chemin, Astro.site)} />
    <meta property="og:title" content={titreComplet} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(chemin, Astro.site)} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Posts" href="/veille/posts.xml" />
    <link rel="alternate" type="application/rss+xml" title="Fiches hebdo" href="/veille/fiches.xml" />
    {aDesNotes && <link rel="alternate" type="application/rss+xml" title="Notes" href="/notes.xml" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Thème : script externe, bloquant, pour appliquer le choix mémorisé avant le premier rendu (CSP : script-src 'self'). -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    {exemple && <div class="bandeau-exemple">site construit sur un jeu d'exemple factice : les contenus de veille affichés ne sont pas réels</div>}
    <header class="entete">
      <div class="conteneur">
        <a class="marque" href="/">MC · Mathieu Casteras</a>
        <nav class="nav" aria-label="Navigation principale">
          {nav.map(([href, label, prefixe]) => <a href={href} aria-current={courant(prefixe)}>{label}</a>)}
          <button class="theme" type="button" id="bascule-theme" aria-label="Changer de thème">Thème</button>
          <a class="bouton" href="/#contact">Me contacter</a>
        </nav>
      </div>
    </header>
    <main class="conteneur">
      <slot />
    </main>
    <footer class="pied">
      <div class="conteneur">
        <span>mathieucasteras.fr — forward deployed engineer</span>
        <span><a href="https://www.linkedin.com/in/mathieu-casteras/" rel="noopener">linkedin</a> · <a href="/veille/posts.xml">rss posts</a> · <a href="/veille/fiches.xml">fiches</a>{aDesNotes && <> · <a href="/notes.xml">notes</a></>} · aucun traqueur</span>
      </div>
    </footer>
  </body>
</html>
