# Fragment Caddy du site, importé par le Caddy partagé du dépôt `serveur` dans le bloc du domaine racine
# (`{$DOMAINE} { import /etc/caddy/sites/site.caddy }`). Ni hôte, ni TLS, ni redirection www : `serveur` s'en charge.
# `serveur` monte le volume `site_dist` sur /srv/site ; `site-builder` y construit chaque version dans releases/<horodatage>
# et bascule le lien symbolique `current` : un build raté ne change rien à ce qui est servi.
root * /srv/site/current
encode zstd gzip

# Webhook appelé par le worker de la veille quand la vitrine change (séance 3 : conteneur `site-builder`, jeton Bearer).
handle /rebuild {
	reverse_proxy site-builder:8080
}

handle {
	file_server
}

# Page 404 du site (dist/404.html, générée par Astro)
handle_errors 404 {
	rewrite * /404.html
	file_server
}

header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
	# Aucun script inline (le thème est dans /theme.js) : un SVG qui passerait le nettoyage ne pourrait rien exécuter.
	Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}
